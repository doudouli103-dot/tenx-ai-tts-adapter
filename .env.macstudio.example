TENX_TTS_ADAPTER_API_KEYS=local-dev-key
TTS_ADAPTER_STORAGE_ROOT=storage/audio
TTS_ADAPTER_ENABLE_MOCK=false
COSYVOICE_COMMAND=conda run -n cosyvoice python ~/ai/CosyVoice/tools/cosyvoice_cli.py --model_dir ~/ai/CosyVoice/pretrained_models/CosyVoice2-0.5B --text {input} --voice {voice} --output {output}
